//! "The keystore says this key does not exist" versus "the lookup failed".
//!
//! `ais_keystore_lib::get_key_data` collapses every failure into one
//! `Err`, so a caller cannot tell an absent key from a keystore that is
//! restarting, a lock it could not take, or a network blip. Both `ais_auth`
//! (JWT signing key) and `ais_secretserver` (the key that encrypts every stored
//! secret) used to treat *any* `Err` as "not there yet -- generate and store a
//! new one". The keystore's `add_key` overwrites an existing id, so a lookup that
//! merely failed at the wrong moment could replace the live key.
//!
//! This asks the keystore directly and reports the three outcomes separately.
//! The only thing that may ever lead to generating a key is [`Lookup::NotFound`],
//! which requires the keystore to *answer* with its explicit not-found message.
//! Everything else -- transport error, gRPC error, an unrecognised failure
//! message, a "success" with no key -- is an `Err`, and the caller must not
//! touch the stored key.
//!
//! Vendored, identical, into each crate that needs it (canonical copy:
//! `ais_proto/keystore_lookup.rs.tmpl`), for the same reason the mTLS client
//! helper is: `ais_keystore_lib` is a published crate we don't change from here.

// Vendored into more than one crate; each uses all of it, but keep it tolerant.
#![allow(dead_code)]

use ais_keystore_lib::grpc::keystore::key_store_client::KeyStoreClient;
use ais_keystore_lib::grpc::keystore::{GetKeyRequest, KeyResponse};
use tonic::transport::Channel;
use tonic::Status;

/// What the keystore's `get_key` says when the id is genuinely absent
/// (`keystore/src/bin/ais_keystore.rs`, `AppMessage::GetKey`). The keystore's
/// wire format has no error code, so this string *is* the signal.
///
/// If the keystore ever changes it, lookups start failing with an error rather
/// than being misread as "absent" -- the safe direction: a fresh install would
/// refuse to bootstrap loudly, not overwrite a key quietly.
pub const NOT_FOUND_MESSAGE: &str = "Key not found";

#[derive(Debug, PartialEq, Eq)]
pub enum Lookup {
    /// The keystore holds this key.
    Found(Vec<u8>),
    /// The keystore answered, and said the key does not exist.
    NotFound,
}

/// Turns one `get_key` outcome into a [`Lookup`] or an error. Pure, so the
/// rules are unit-tested without a keystore.
pub fn classify(result: Result<KeyResponse, Status>) -> Result<Lookup, String> {
    let response = result.map_err(|status| {
        format!("keystore lookup failed: {} ({:?})", status.message(), status.code())
    })?;

    if response.success {
        return match response.key {
            // A stored-but-empty key would sign/encrypt with nothing; treat it
            // as damage, not as a key.
            Some(key) if !key.value.is_empty() => Ok(Lookup::Found(key.value)),
            Some(_) => Err("keystore returned an empty key".to_owned()),
            None => Err("keystore reported success but returned no key".to_owned()),
        };
    }

    if response.message == NOT_FOUND_MESSAGE {
        Ok(Lookup::NotFound)
    } else {
        Err(format!("keystore lookup failed: {}", response.message))
    }
}

/// Fetches the latest version of `id`.
pub async fn lookup(conn: &mut KeyStoreClient<Channel>, id: &str) -> Result<Lookup, String> {
    classify(
        conn.get_key(GetKeyRequest { id: id.to_owned(), version: 0 })
            .await
            .map(|response| response.into_inner()),
    )
}

#[cfg(test)]
mod lookup_tests {
    use super::*;
    use ais_keystore_lib::grpc::keystore::Key;
    use tonic::Code;

    fn key(value: &[u8]) -> Key {
        Key { id: "k".into(), value: value.to_vec(), ..Default::default() }
    }
    fn ok(key: Option<Key>) -> Result<KeyResponse, Status> {
        Ok(KeyResponse { success: true, message: String::new(), key })
    }
    fn refused(message: &str) -> Result<KeyResponse, Status> {
        Ok(KeyResponse { success: false, message: message.into(), key: None })
    }

    #[test]
    fn a_stored_key_is_found() {
        assert_eq!(classify(ok(Some(key(b"secret")))), Ok(Lookup::Found(b"secret".to_vec())));
    }

    #[test]
    fn only_the_explicit_not_found_answer_means_absent() {
        assert_eq!(classify(refused("Key not found")), Ok(Lookup::NotFound));
    }

    #[test]
    fn the_not_found_message_is_pinned_to_what_the_real_keystore_says() {
        // keystore/src/bin/ais_keystore.rs: `message: "Key not found".into()`.
        assert_eq!(NOT_FOUND_MESSAGE, "Key not found");
    }

    #[test]
    fn every_other_failure_is_an_error_never_absent() {
        // A lock the keystore could not take, and a differently-worded refusal.
        for message in ["lock error: timed out", "Key store is locked", "key not found", "Key not found.", ""] {
            assert!(classify(refused(message)).is_err(), "{message:?} must not read as not-found");
        }
    }

    #[test]
    fn transport_and_grpc_errors_are_errors_never_absent() {
        for code in [Code::Unavailable, Code::DeadlineExceeded, Code::Internal, Code::Unknown, Code::NotFound, Code::PermissionDenied] {
            assert!(classify(Err(Status::new(code, "x"))).is_err(), "{code:?}");
        }
    }

    #[test]
    fn a_success_without_a_usable_key_is_an_error() {
        assert!(classify(ok(None)).is_err());
        assert!(classify(ok(Some(key(b"")))).is_err());
    }
}
